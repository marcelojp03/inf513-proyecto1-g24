# Copiá este archivo como .env y completá tus valores. .env está ignorado por Git.
# No pongas credenciales reales en README, en este ejemplo ni en el ZIP de entrega.

DB_URL=jdbc:postgresql://127.0.0.1:5432/banco_talentos_mail
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_clave_postgres

# Buzón de cátedra (POP3). TLS usa 995; PLAIN solo se admite en localhost.
POP3_HOST=
POP3_USER=
POP3_PASSWORD=
POP3_SECURITY=TLS
POP3_PORT=995

# Salida SMTP. STARTTLS usa 587; TLS usa 465.
# El SMTP de la cátedra puede rechazar relay externo; en ese caso usá una cuenta
# con App Password (por ejemplo smtp.gmail.com:587) y poné esa dirección en MAIL_FROM.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=STARTTLS
SMTP_PORT=587

# Remitente de las respuestas: debe pertenecer a la cuenta POP3.
MAIL_FROM=

# Opcional: ignora correos anteriores a esta fecha (AAAA-MM-DD) sin responderlos.
# Sirve en cuentas reutilizadas entre semestres.
MAIL_DESDE=

# El servidor de laboratorio puede ofrecer solo 110/25 sin TLS. Habilitá esto únicamente
# si la cátedra lo confirma: en ese caso las credenciales viajan sin cifrar.
ALLOW_PLAINTEXT_MAIL=NO

# Solo se lee con --crear-admin para el primer administrador.
ADMIN_EMAIL=

POLL_SECONDS=15
LOG_DIR=logs
